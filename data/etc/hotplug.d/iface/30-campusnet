#!/bin/sh
# campusnet hotplug：目标SSID接口 连接/断开 事件即时处理

[ "$(uci -q get campusnet.main.enabled)" = "1" ] || exit 0
CORE=/usr/libexec/campusnet/campusnet.sh

case "$ACTION" in
    ifup)
        # 等关联与DHCP稳定，后台检测连通性、ping不通当场认证，不阻塞hotplug
        (sleep 3; "$CORE" run) &
        ;;
    ifdown)
        echo "$(date '+%Y-%m-%d %H:%M:%S') 接口 $INTERFACE 断开，等待重连触发认证" >> /tmp/campusnet.log
        ;;
esac
exit 0
