#!/bin/sh
if [ -z "$IPKG_INSTROOT" ]; then
	/etc/init.d/campusnet stop 2>/dev/null
	/etc/init.d/campusnet disable 2>/dev/null
	if [ -f /etc/crontabs/root ]; then
		grep -v 'campusnet-auto' /etc/crontabs/root > /tmp/campusnet.cron 2>/dev/null
		mv /tmp/campusnet.cron /etc/crontabs/root
		/etc/init.d/cron restart 2>/dev/null
	fi
	rm -f /tmp/luci-indexcache.*
	rm -rf /tmp/luci-modulecache/
fi
exit 0
